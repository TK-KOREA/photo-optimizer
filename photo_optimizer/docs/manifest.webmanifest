{
  "id": "/photo-optimizer/",
  "name": "Photo Optimizer",
  "short_name": "Photo Optimizer",
  "description": "2억 화소 사진을 눈에 띄는 화질 차이 없이 7MB 안팎으로 줄입니다. 사진은 기기 밖으로 전송되지 않습니다.",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbfbfd",
  "theme_color": "#fbfbfd",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/tiff",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".tif",
            ".tiff"
          ]
        }
      ]
    }
  }
}
